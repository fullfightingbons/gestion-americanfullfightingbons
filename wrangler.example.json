{
  "compatibility_date": "2025-12-17",
  "main": "src/index.ts",
  "name": "gestion-americanfullfightingbons",
  "upload_source_maps": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "<AFFBC_PRODUCTION_DATABASE_ID>",
      "database_name": "affbc-production"
    },
    {
      "binding": "DB_BOUTIQUE",
      "database_id": "<BOUTIQUE_DATABASE_ID>",
      "database_name": "boutique-americanfullfightingbons"
    },
    {
      "binding": "DB_CALENDRIER",
      "database_id": "<CALENDRIER_DATABASE_ID>",
      "database_name": "calendrier-americanfullfightingbonsdb"
    },
    {
      "binding": "DB_SITE",
      "database_id": "<SITE_DATABASE_ID>",
      "database_name": "site-americanfullfightinbons"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_STORAGE",
      "bucket_name": "storage"
    },
    {
      "binding": "R2_PDF",
      "bucket_name": "fullfighting-pdf"
    }
  ],

  "observability": {
    "enabled": true
  },

  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
